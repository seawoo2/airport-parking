# 공공데이터포털 '인천국제공항공사_주차 정보' 서비스키 (실제 값은 .env에만 저장)
AIRPORT_PARKING_SERVICE_KEY=
# 승객예고 API에 별도의 서비스키를 사용할 경우에만 입력합니다.
AIRPORT_PASSENGER_SERVICE_KEY=
AIRPORT_FLIGHT_SERVICE_KEY=
HOLIDAY_SERVICE_KEY=

# 로컬 Docker PostgreSQL. 클라우드에서는 실행 환경의 비밀 변수로 지정
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=airport_parking
POSTGRES_USER=airport_app
POSTGRES_PASSWORD=
